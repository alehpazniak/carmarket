# Environment variable template for the CarMarket local stack (docker-compose.yml).
# Copy this file to `.env` in the repo root, then fill in real values:
#   cp .env.example .env
#
# `.env` is git-ignored — never commit real secrets.

# ── Google OAuth2 (required for "Zaloguj się" / Google login) ───────────────
# Get these from https://console.cloud.google.com/apis/credentials
# 1. Create an OAuth 2.0 Client ID of type "Web application"
# 2. Add authorized redirect URI: http://localhost:8081/auth/oauth2/callback/google
#    (phone/remote testing: use an HTTPS tunnel URL instead and set GOOGLE_REDIRECT_URI to it)
# 3. Copy the generated Client ID + Client secret below.
# Without these set, Google returns "Error 401: invalid_client" on login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Facebook OAuth2 (optional — only needed if Facebook login is enabled) ───
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── Where auth-service sends the browser after a successful login ───────────
# Must match the frontend's dev server (Vite default: 5173).
OAUTH2_REDIRECT_URI=http://localhost:5173/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:8081/auth/oauth2/callback/google
OAUTH2_ALLOWED_HOSTS=localhost

# ── First admins ─────────────────────────────────────────────────────────────
# Comma-separated emails promoted to ADMIN when they log in (never demoted automatically;
# removing an address only stops future promotions). Example: ADMIN_EMAILS=you@gmail.com
ADMIN_EMAILS=

# ── JWT signing secret — override the built-in dev default in production ────
JWT_SECRET=bXlTdXBlclNlY3JldEtleUZvckNhck1hcmtldEp3dFRva2VuMjAyNA==

# ── Eureka service registry basic-auth credentials ───────────────────────────
EUREKA_USER=admin
EUREKA_PASSWORD=admin

# ── Redis password (leave empty for the default local setup) ────────────────
REDIS_PASSWORD=

# ── Reverse proxies in front of the API gateway ──────────────────────────────
# 0 locally: client IP = direct remote address, X-Forwarded-For is ignored (a client could fake it).
# Deployed: the number of proxies / load balancers in front of the gateway, in both variables.
GATEWAY_TRUSTED_PROXIES=0
IMPORT_ORDER_TRUSTED_PROXIES=0

# ── Anonymous Apibara live lookups (api-gateway rate limits) ─────────────────
# Free package values — raise after buying a bigger package.
# Per IP: requests per second and burst (the vehicle page sends 3 lookups at once).
APIBARA_ANON_PER_IP_PER_SECOND=1
APIBARA_ANON_PER_IP_BURST=5
# All anonymous users together, per rolling 30 days (the rest of the quota stays for logged-in users).
APIBARA_ANON_GLOBAL_PER_MONTH=50

# ── Apibara feed sync (auction-import-service, apibara.sync) ─────────────────
# Free plan until 31 Oct 2026: one run a day at 08:00 Europe/Warsaw.
# Basic from 1 Nov: APIBARA_SYNC_MONTHLY_BUDGET=22000, APIBARA_KEEP_REMAINING=1000.
APIBARA_SYNC_ENABLED=true
APIBARA_SYNC_MONTHLY_BUDGET=60
APIBARA_KEEP_REMAINING=10

# ── Przelewy24 payments (payment-service) ────────────────────────────────────
# From the P24 panel: "Moje dane" → "Dane API i konfiguracja" (sandbox has its own set).
# Leave empty until registration is done — payment-service starts, payment calls return 503.
P24_SANDBOX=true
P24_MERCHANT_ID=
# Only if P24 gave you a POS id different from the merchant id
P24_POS_ID=
P24_CRC=
# "Klucz do raportów" (secretId) — the REST API password
P24_API_KEY=
# Browser lands on <this URL>/<paymentId> after paying
P24_URL_RETURN=http://localhost:5173/platnosc
# Must be publicly reachable over HTTPS by P24 (use a tunnel such as ngrok for local tests).
# Locally, without a tunnel, the return page's /sync call still confirms the payment.
P24_URL_STATUS=http://localhost:8080/api/payments/p24/notify
# true = accept notifications only from P24 server IP ranges (enable in production)
P24_VERIFY_NOTIFICATION_IP=false

# ── Import orders (import-order-service) ─────────────────────────────────────
# Base of the client link sent by dealers: <FRONTEND_URL>/zlecenie/<code>
FRONTEND_URL=http://localhost:5173
# Signs the client page tokens (X-Order-Token); at least 32 bytes. Empty = built-in dev default.
IMPORT_ORDER_TOKEN_SECRET=
# car-service S3 (listing photos). Required by docker compose.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Private bucket for invoices and photos. Use an IAM user limited to import-orders/* in this
# bucket — NOT car-service's AWS_* keys. Leave empty: the service starts, file endpoints return 503.
IMPORT_ORDER_S3_BUCKET=
IMPORT_ORDER_S3_REGION=
IMPORT_ORDER_AWS_ACCESS_KEY_ID=
IMPORT_ORDER_AWS_SECRET_ACCESS_KEY=
