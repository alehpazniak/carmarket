# Environment variable template for the CarMarket local stack (docker-compose.yml).
# Copy this file to `.env` in the repo root, then fill in real values:
#   cp .env.example .env
#
# `.env` is git-ignored — never commit real secrets.

# ── Google OAuth2 (required for "Zaloguj się" / Google login) ───────────────
# Get these from https://console.cloud.google.com/apis/credentials
# 1. Create an OAuth 2.0 Client ID of type "Web application"
# 2. Add authorized redirect URI: http://localhost:8081/auth/oauth2/callback/google
#    (phone/remote testing: use an HTTPS tunnel URL instead and set GOOGLE_REDIRECT_URI to it)
# 3. Copy the generated Client ID + Client secret below.
# Without these set, Google returns "Error 401: invalid_client" on login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Facebook OAuth2 (optional — only needed if Facebook login is enabled) ───
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── Where auth-service sends the browser after a successful login ───────────
# Must match the frontend's dev server (Vite default: 5173).
OAUTH2_REDIRECT_URI=http://localhost:5173/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:8081/auth/oauth2/callback/google
OAUTH2_ALLOWED_HOSTS=localhost

# ── JWT signing secret — override the built-in dev default in production ────
JWT_SECRET=bXlTdXBlclNlY3JldEtleUZvckNhck1hcmtldEp3dFRva2VuMjAyNA==

# ── Eureka service registry basic-auth credentials ───────────────────────────
EUREKA_USER=admin
EUREKA_PASSWORD=admin

# ── Redis password (leave empty for the default local setup) ────────────────
REDIS_PASSWORD=
